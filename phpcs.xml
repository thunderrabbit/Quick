<?xml version="1.0"?>
<ruleset name="quick">
    <description>
        quick style gate: PSR-12, kept green via phpcbf. The excludes below are
        PSR-12 sniffs quick does not yet satisfy AND phpcbf cannot auto-fix (they
        need manual code changes). Remove an exclude once its code is cleaned up.
        (templates/*.tpl.php are mixed HTML/PHP and out of scope.)
    </description>

    <file>classes</file>
    <file>public</file>
    <file>bin</file>
    <file>Tests</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/Tests/_output/*</exclude-pattern>
    <exclude-pattern>*/Tests/Support/_generated/*</exclude-pattern>

    <rule ref="PSR12">
        <!-- Pending manual cleanup (phpcbf can't auto-fix; counts 2026-07-20): -->
        <exclude name="Generic.Files.LineLength"/>              <!-- 18: long lines -->
        <exclude name="PSR1.Classes.ClassDeclaration"/>         <!-- 11: missing namespace / multiple classes -->
        <exclude name="Squiz.Scope.MethodScope"/>               <!-- 2: methods missing visibility -->
        <exclude name="Squiz.ControlStructures.ControlSignature"/> <!-- 2 -->
        <exclude name="PSR1.Files.SideEffects"/>                <!-- 2: declaration + side effects -->
        <exclude name="PSR12.Files.FileHeader"/>                <!-- 2 -->
        <exclude name="PSR12.Classes.ClosingBrace"/>            <!-- 2 -->
    </rule>

    <!-- Codeception calls _before() and _after() by those exact names. -->
    <rule ref="PSR2.Methods.MethodDeclaration.Underscore">
        <exclude-pattern>*/Tests/*</exclude-pattern>
    </rule>
</ruleset>
